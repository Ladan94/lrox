import time
import serial
import subprocess
from collections import deque

PORT = "/dev/serial0"
BAUD = 115200

# فقط هشدار نهایی
STOP_DISTANCE = 40        # cm؛ فقط خیلی نزدیک
STOP_TTC = 1.2            # seconds
MIN_STOP_SPEED = 45       # cm/s؛ فقط اگر واقعاً نزدیک می‌شوی

MIN_STRENGTH = 50
MIN_DIST = 10
MAX_DIST = 1200

DIST_WINDOW = 5
SPEED_WINDOW = 12

STOP_CONFIRM = 5
SAFE_CONFIRM = 5
NO_OBJECT_LIMIT = 8

STOP_GAP = 3.0            # حداقل فاصله بین دو Stop


def speak_stop():
    subprocess.Popen(
        ["espeak", "-s", "145", "-a", "180", "Stop"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def median(values):
    values = sorted(values)
    return values[len(values) // 2]


def main():
    ser = serial.Serial(PORT, BAUD, timeout=0.2)
    buf = bytearray()

    dist_hist = deque(maxlen=DIST_WINDOW)
    speed_hist = deque(maxlen=SPEED_WINDOW)

    level = "SAFE"
    stop_count = 0
    safe_count = 0
    no_object_count = 0
    last_stop_time = 0.0

    print("TFmini STOP-only TTC assistant")
    print("Only says Stop when close + approaching")
    print("Ctrl+C to stop")

    while True:
        buf += ser.read(64)
        got_frame = False

        while len(buf) >= 9:
            if buf[0] != 0x59 or buf[1] != 0x59:
                buf.pop(0)
                continue

            frame = buf[:9]
            buf = buf[9:]

            if (sum(frame[:8]) & 0xFF) != frame[8]:
                continue

            dist = frame[2] | (frame[3] << 8)
            strength = frame[4] | (frame[5] << 8)

            if strength < MIN_STRENGTH or dist < MIN_DIST or dist > MAX_DIST:
                continue

            got_frame = True
            no_object_count = 0

            now = time.time()
            dist_hist.append(dist)
            speed_hist.append((now, dist))

            if len(dist_hist) < DIST_WINDOW or len(speed_hist) < 5:
                continue

            stable = median(list(dist_hist))

            t0, d0 = speed_hist[0]
            t1, d1 = speed_hist[-1]
            dt = max(0.001, t1 - t0)

            speed = (d0 - d1) / dt  # مثبت یعنی داری نزدیک می‌شی

            ttc = None
            if speed >= MIN_STOP_SPEED:
                ttc = stable / speed

            stop_raw = False

            # حالت ۱: خیلی نزدیک + واقعاً نزدیک‌شدن
            if stable <= STOP_DISTANCE and speed >= MIN_STOP_SPEED:
                stop_raw = True

            # حالت ۲: TTC خطرناک + واقعاً نزدیک‌شدن
            elif ttc is not None and ttc <= STOP_TTC and stable <= 180:
                stop_raw = True

            if stop_raw:
                stop_count += 1
                safe_count = 0
            else:
                safe_count += 1
                stop_count = 0

            if stop_count >= STOP_CONFIRM:
                level = "STOP"
            elif safe_count >= SAFE_CONFIRM:
                level = "SAFE"

            print(
                f"level={level:5s} dist={dist:4d} stable={stable:4d} "
                f"speed={speed:6.1f}cm/s "
                f"ttc={'None' if ttc is None else f'{ttc:.2f}s'} "
                f"stop_count={stop_count} safe_count={safe_count}"
            )

            now_voice = time.time()

            if level == "STOP":
                if now_voice - last_stop_time >= STOP_GAP:
                    speak_stop()
                    last_stop_time = now_voice

        if not got_frame:
            no_object_count += 1
            if no_object_count >= NO_OBJECT_LIMIT:
                level = "SAFE"
                stop_count = 0
                safe_count = 0
                dist_hist.clear()
                speed_hist.clear()

        time.sleep(0.03)


if __name__ == "__main__":
    main()
