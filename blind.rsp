import time
import serial
import subprocess
from collections import deque

PORT = "/dev/serial0"
BAUD = 115200

# فاصله‌ها برای آدم پیاده
WARN_DISTANCE = 120
DANGER_DISTANCE = 50

# TTC
WARN_TTC = 3.0
DANGER_TTC = 1.4

# فقط اگر واقعاً داری نزدیک می‌شی
MIN_WARN_SPEED = 25
MIN_DANGER_SPEED = 45

MIN_STRENGTH = 50
MIN_DIST = 10
MAX_DIST = 1200

DIST_WINDOW = 5
SPEED_WINDOW = 12

WARN_CONFIRM = 5
DANGER_CONFIRM = 4
SAFE_CONFIRM = 8

NO_OBJECT_LIMIT = 8


def speak_once(text):
    # نگذارد صداها روی هم بیفتند
    subprocess.run(["pkill", "-f", "espeak"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen(
        ["espeak", "-s", "145", "-a", "180", text],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def median(values):
    values = sorted(values)
    return values[len(values) // 2]


def main():
    ser = serial.Serial(PORT, BAUD, timeout=0.2)
    buf = bytearray()

    dist_hist = deque(maxlen=DIST_WINDOW)
    speed_hist = deque(maxlen=SPEED_WINDOW)

    level = "SAFE"
    last_voice_level = "SAFE"

    warn_count = 0
    danger_count = 0
    safe_count = 0
    no_object_count = 0

    print("TFmini assistant stable version")
    speak_once("System ready")

    while True:
        buf += ser.read(64)
        got_frame = False

        while len(buf) >= 9:
            if buf[0] != 0x59 or buf[1] != 0x59:
                buf.pop(0)
                continue

            frame = buf[:9]
            buf = buf[9:]

            if (sum(frame[:8]) & 0xFF) != frame[8]:
                continue

            dist = frame[2] | (frame[3] << 8)
            strength = frame[4] | (frame[5] << 8)

            if strength < MIN_STRENGTH or dist < MIN_DIST or dist > MAX_DIST:
                continue

            got_frame = True
            no_object_count = 0

            now = time.time()
            dist_hist.append(dist)
            speed_hist.append((now, dist))

            if len(dist_hist) < DIST_WINDOW or len(speed_hist) < 5:
                continue

            stable = median(list(dist_hist))

            t0, d0 = speed_hist[0]
            t1, d1 = speed_hist[-1]
            dt = max(0.001, t1 - t0)

            speed = (d0 - d1) / dt  # مثبت یعنی نزدیک می‌شی

            ttc = None
            if speed >= MIN_WARN_SPEED:
                ttc = stable / speed

            danger_raw = False
            warn_raw = False

            # DANGER فقط وقتی نزدیک شدن واقعی هست
            if stable <= DANGER_DISTANCE and speed >= MIN_DANGER_SPEED:
                danger_raw = True
            elif ttc is not None and ttc <= DANGER_TTC and speed >= MIN_DANGER_SPEED and stable <= 180:
                danger_raw = True

            # WARN اگر جسم نزدیکه یا داری بهش نزدیک می‌شی
            elif stable <= WARN_DISTANCE:
                warn_raw = True
            elif ttc is not None and ttc <= WARN_TTC and stable <= 240:
                warn_raw = True

            if danger_raw:
                danger_count += 1
                warn_count = 0
                safe_count = 0
            elif warn_raw:
                warn_count += 1
                danger_count = 0
                safe_count = 0
            else:
                safe_count += 1
                warn_count = 0
                danger_count = 0

            old_level = level

            if danger_count >= DANGER_CONFIRM:
                level = "DANGER"
            elif warn_count >= WARN_CONFIRM:
                level = "WARN"
            elif safe_count >= SAFE_CONFIRM:
                level = "SAFE"

            print(
                f"level={level:6s} dist={dist:4d} stable={stable:4d} "
                f"speed={speed:6.1f} ttc={'None' if ttc is None else f'{ttc:.2f}'} "
                f"warn={warn_count} danger={danger_count} safe={safe_count}"
            )

            # صدا فقط وقتی حالت بالا می‌رود
            if level != last_voice_level:
                if level == "DANGER":
                    speak_once("Stop")
                    last_voice_level = "DANGER"

                elif level == "WARN" and last_voice_level == "SAFE":
                    speak_once("Object ahead")
                    last_voice_level = "WARN"

                elif level == "SAFE":
                    last_voice_level = "SAFE"

        if not got_frame:
            no_object_count += 1
            if no_object_count >= NO_OBJECT_LIMIT:
                level = "SAFE"
                last_voice_level = "SAFE"
                warn_count = 0
                danger_count = 0
                safe_count = 0
                dist_hist.clear()
                speed_hist.clear()

        time.sleep(0.03)


if __name__ == "__main__":
    main()
