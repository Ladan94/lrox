import time
import serial
import subprocess
from collections import deque

PORT = "/dev/serial0"
BAUD = 115200

# =========================
# MODE
# =========================
# WEARABLE:
#   فقط منطق اصلی تو فعال است.
#
# STATIONARY_TTC_ONLY:
#   فقط برای تست TTC وقتی دستگاه روی میز ثابت است.
#
# COMBINED:
#   منطق اصلی تو + TTC به عنوان هشدار زودهنگام برای جسم سریع از فاصله دور.
DEVICE_MODE = "COMBINED"


# =========================
# ORIGINAL CORE LOGIC
# این بخش همان منطق اصلی خودت است و تغییر نکرده
# =========================

STOP_DISTANCE = 40        # cm؛ فقط خیلی نزدیک
STOP_TTC = 1.2            # seconds
MIN_STOP_SPEED = 45       # cm/s؛ فقط اگر واقعاً نزدیک می‌شوی

MIN_STRENGTH = 50
MIN_DIST = 10
MAX_DIST = 1200

DIST_WINDOW = 5
SPEED_WINDOW = 12

STOP_CONFIRM = 5
SAFE_CONFIRM = 5
NO_OBJECT_LIMIT = 8

STOP_GAP = 3.0            # حداقل فاصله بین دو Stop


# =========================
# STATIONARY TTC LOGIC
# برای جسم سریع نزدیک‌شونده
# =========================

ST_TTC_ENABLED = True

# در حالت STATIONARY_TTC_ONLY، TTC می‌تواند از این فاصله به بعد کار کند
ST_MIN_DISTANCE = 45          # cm

# در حالت COMBINED، TTC فقط از فاصله دورتر از این مقدار اجازه هشدار دارد
# تا با منطق اصلی نزدیک‌برد تو تداخل نکند
ST_ADDON_MIN_DISTANCE = 200   # cm

ST_MAX_DISTANCE = 450         # cm؛ بیشتر از 4.5m فعلاً هشدار نده

# آستانه سرعت نزدیک‌شدن
ST_MIN_CLOSING_SPEED = 165    # cm/s

# اگر زمان برخورد کمتر از این باشد، خطر حساب شود
ST_TTC_DANGER = 1.8           # seconds

# برای جلوگیری از سرعت‌های غیرواقعی
ST_MAX_VALID_SPEED = 700      # cm/s

# باید چند نمونه جدید پشت سر هم تأیید شود
ST_CONFIRM = 2

# نمونه‌برداری برای TTC
ST_SAMPLE_GAP = 0.05          # seconds
ST_WINDOW = 7                 # تعداد نمونه‌ها
ST_MIN_DT = 0.22              # حداقل زمان بین اولین و آخرین نمونه

# برای اینکه عقب رفتن یا نویز باعث Stop نشود
ST_MIN_NET_DROP = 18          # cm؛ فاصله باید حداقل این‌قدر کم شده باشد
ST_DECREASE_RATIO = 0.65      # حداقل 65 درصد حرکت‌ها باید کاهشی باشند
ST_NOISE_TOLERANCE = 2        # cm؛ تغییرات کمتر از این نویز حساب می‌شود


def speak_stop():
    subprocess.Popen(
        ["espeak", "-s", "145", "-a", "180", "Stop"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def median(values):
    values = sorted(values)
    return values[len(values) // 2]


def fmt_ttc(value):
    return "None" if value is None else f"{value:.2f}s"


def fmt_speed(value):
    return "None" if value is None else f"{value:.1f}"


def stationary_ttc_check(st_hist, stable):
    """
    این تابع فقط برای TTC جسم سریع نزدیک‌شونده است.

    خروجی:
      danger, st_speed, st_ttc, trend_ok

    قانون:
    - فاصله باید واقعاً در حال کم شدن باشد
    - سرعت باید از حد مشخص بیشتر باشد
    - TTC باید پایین باشد
    - روند باید بیشتر کاهشی باشد، نه نوسانی
    """

    if len(st_hist) < ST_WINDOW:
        return False, None, None, False

    t_first, d_first = st_hist[0]
    t_last, d_last = st_hist[-1]
    dt = t_last - t_first

    if dt < ST_MIN_DT:
        return False, None, None, False

    net_drop = d_first - d_last  # مثبت یعنی نزدیک شدن

    # اگر فاصله کم نشده، یعنی جسم نزدیک نمی‌شود
    if net_drop < ST_MIN_NET_DROP:
        return False, None, None, False

    # بررسی روند: چند حرکت واقعاً کاهشی بوده؟
    decreases = 0
    total_moves = 0

    items = list(st_hist)

    for i in range(1, len(items)):
        prev_d = items[i - 1][1]
        curr_d = items[i][1]
        diff = prev_d - curr_d

        if abs(diff) <= ST_NOISE_TOLERANCE:
            continue

        total_moves += 1

        if diff > 0:
            decreases += 1

    if total_moves == 0:
        return False, None, None, False

    decrease_ratio = decreases / total_moves
    trend_ok = decrease_ratio >= ST_DECREASE_RATIO

    if not trend_ok:
        return False, None, None, False

    st_speed = net_drop / dt  # cm/s

    if st_speed < ST_MIN_CLOSING_SPEED:
        return False, st_speed, None, trend_ok

    if st_speed > ST_MAX_VALID_SPEED:
        return False, st_speed, None, trend_ok

    st_ttc = stable / st_speed

    if st_ttc <= ST_TTC_DANGER:
        return True, st_speed, st_ttc, trend_ok

    return False, st_speed, st_ttc, trend_ok


def main():
    ser = serial.Serial(PORT, BAUD, timeout=0.2)
    buf = bytearray()

    dist_hist = deque(maxlen=DIST_WINDOW)
    speed_hist = deque(maxlen=SPEED_WINDOW)

    # History جدا فقط برای TTC
    st_hist = deque(maxlen=ST_WINDOW)
    last_st_sample_time = 0.0

    st_count = 0
    st_stop_raw = False
    st_speed = None
    st_ttc = None
    st_trend_ok = False

    level = "SAFE"
    stop_count = 0
    safe_count = 0
    no_object_count = 0
    last_stop_time = 0.0

    print("TFmini STOP assistant")
    print(f"DEVICE_MODE = {DEVICE_MODE}")
    print("Voice output is only: Stop")
    print("Ctrl+C to stop")

    while True:
        buf += ser.read(64)
        got_frame = False

        while len(buf) >= 9:
            if buf[0] != 0x59 or buf[1] != 0x59:
                buf.pop(0)
                continue

            frame = buf[:9]
            buf = buf[9:]

            if (sum(frame[:8]) & 0xFF) != frame[8]:
                continue

            dist = frame[2] | (frame[3] << 8)
            strength = frame[4] | (frame[5] << 8)

            if strength < MIN_STRENGTH or dist < MIN_DIST or dist > MAX_DIST:
                continue

            got_frame = True
            no_object_count = 0

            now = time.time()

            dist_hist.append(dist)
            speed_hist.append((now, dist))

            if len(dist_hist) < DIST_WINDOW or len(speed_hist) < 5:
                continue

            stable = median(list(dist_hist))

            # =========================
            # ORIGINAL CORE LOGIC
            # این قسمت همان روش اول توست و تغییر نکرده
            # =========================

            t0, d0 = speed_hist[0]
            t1, d1 = speed_hist[-1]
            dt = max(0.001, t1 - t0)

            speed = (d0 - d1) / dt  # مثبت یعنی داری نزدیک می‌شی

            ttc = None

            if speed >= MIN_STOP_SPEED:
                ttc = stable / speed

            core_stop_raw = False

            # حالت ۱: خیلی نزدیک + واقعاً نزدیک‌شدن
            if stable <= STOP_DISTANCE and speed >= MIN_STOP_SPEED:
                core_stop_raw = True

            # حالت ۲: TTC خطرناک + واقعاً نزدیک‌شدن
            elif ttc is not None and ttc <= STOP_TTC and stable <= 180:
                core_stop_raw = True

            # =========================
            # STATIONARY TTC
            # هشدار زودهنگام برای جسم سریع نزدیک‌شونده
            # =========================

            new_st_sample = False

            # در حالت COMBINED، TTC فقط از فاصله دورتر فعال است.
            # در حالت تست، از ST_MIN_DISTANCE فعال است.
            if DEVICE_MODE == "COMBINED":
                st_active_min_distance = ST_ADDON_MIN_DISTANCE
            else:
                st_active_min_distance = ST_MIN_DISTANCE

            if ST_TTC_ENABLED and DEVICE_MODE in ("STATIONARY_TTC_ONLY", "COMBINED"):

                if st_active_min_distance <= stable <= ST_MAX_DISTANCE:

                    if now - last_st_sample_time >= ST_SAMPLE_GAP:
                        st_hist.append((now, stable))
                        last_st_sample_time = now
                        new_st_sample = True

                    # فقط وقتی نمونه جدید داریم TTC را بررسی و شمارش می‌کنیم
                    if new_st_sample:

                        st_stop_raw, st_speed, st_ttc, st_trend_ok = stationary_ttc_check(
                            st_hist,
                            stable,
                        )

                        if st_stop_raw:
                            st_count += 1
                        else:
                            st_count = 0

                else:
                    st_hist.clear()
                    st_count = 0
                    st_stop_raw = False
                    st_speed = None
                    st_ttc = None
                    st_trend_ok = False

            else:
                st_hist.clear()
                st_count = 0
                st_stop_raw = False
                st_speed = None
                st_ttc = None
                st_trend_ok = False

            st_confirmed = st_count >= ST_CONFIRM

            # =========================
            # FINAL DECISION
            # =========================

            if DEVICE_MODE == "WEARABLE":

                # فقط منطق اصلی تو
                final_stop_raw = core_stop_raw

                if core_stop_raw:
                    reason = "CORE"
                else:
                    reason = "-"

            elif DEVICE_MODE == "STATIONARY_TTC_ONLY":

                # فقط TTC برای تست دستگاه ثابت
                final_stop_raw = st_confirmed

                if st_confirmed:
                    reason = "ST_TTC"
                elif st_stop_raw:
                    reason = "ST_RAW"
                elif core_stop_raw:
                    reason = "CORE_IGNORED"
                else:
                    reason = "-"

            elif DEVICE_MODE == "COMBINED":

                # منطق اصلی تو + TTC فقط در فاصله دورتر از 200cm
                final_stop_raw = core_stop_raw or st_confirmed

                if core_stop_raw and st_confirmed:
                    reason = "CORE+ST_TTC"
                elif core_stop_raw:
                    reason = "CORE"
                elif st_confirmed:
                    reason = "ST_TTC"
                elif st_stop_raw:
                    reason = "ST_RAW"
                else:
                    reason = "-"

            else:

                # اگر نام حالت اشتباه نوشته شده بود، امن رفتار کن
                final_stop_raw = core_stop_raw

                if core_stop_raw:
                    reason = "CORE_SAFE_FALLBACK"
                else:
                    reason = "-"

            if final_stop_raw:
                stop_count += 1
                safe_count = 0
            else:
                safe_count += 1
                stop_count = 0

            if stop_count >= STOP_CONFIRM:
                level = "STOP"
            elif safe_count >= SAFE_CONFIRM:
                level = "SAFE"

            print(
                f"mode={DEVICE_MODE:19s} "
                f"level={level:5s} "
                f"dist={dist:4d} stable={stable:4d} "
                f"speed={speed:7.1f}cm/s "
                f"ttc={fmt_ttc(ttc):>6s} "
                f"st_speed={fmt_speed(st_speed):>6s} "
                f"st_ttc={fmt_ttc(st_ttc):>6s} "
                f"st_count={st_count} "
                f"trend={st_trend_ok} "
                f"reason={reason:13s} "
                f"stop_count={stop_count} safe_count={safe_count}"
            )

            now_voice = time.time()

            if level == "STOP":
                if now_voice - last_stop_time >= STOP_GAP:

                    print(
                        f"VOICE_STOP reason={reason} "
                        f"stable={stable}cm "
                        f"speed={speed:.1f}cm/s "
                        f"ttc={fmt_ttc(ttc)} "
                        f"st_speed={fmt_speed(st_speed)}cm/s "
                        f"st_ttc={fmt_ttc(st_ttc)}"
                    )

                    speak_stop()
                    last_stop_time = now_voice

        if not got_frame:
            no_object_count += 1

            if no_object_count >= NO_OBJECT_LIMIT:
                level = "SAFE"
                stop_count = 0
                safe_count = 0
                no_object_count = 0

                st_count = 0
                st_stop_raw = False
                st_speed = None
                st_ttc = None
                st_trend_ok = False

                dist_hist.clear()
                speed_hist.clear()
                st_hist.clear()

                last_st_sample_time = 0.0

        time.sleep(0.03)


if __name__ == "__main__":
    main()
