import time
import serial
import subprocess
import threading
import queue
from collections import deque

PORT = "/dev/serial0"
BAUD = 115200

MIN_DIST = 25
MAX_DIST = 450
MIN_STRENGTH = 80

WARN_DISTANCE = 130
DANGER_DISTANCE = 60

WARN_TTC = 2.8
DANGER_TTC = 1.3

MIN_CLOSING_SPEED = 40
HISTORY = 10

REQUIRE_FRAMES_WARN = 4
REQUIRE_FRAMES_DANGER = 3
NO_OBJECT_RESET_FRAMES = 5


class Speaker:
    def __init__(self):
        self.q = queue.Queue(maxsize=5)
        self.last_t = 0
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def say(self, text, gap):
        now = time.time()
        if now - self.last_t < gap:
            return
        self.last_t = now
        try:
            self.q.put_nowait(text)
        except queue.Full:
            pass

    def _run(self):
        while True:
            text = self.q.get()
            subprocess.Popen(
                ["espeak", "-s", "145", "-a", "180", text],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )


def read_tfmini(ser):
    while True:
        b = ser.read(1)
        if not b:
            return None

        if b[0] != 0x59:
            continue

        b2 = ser.read(1)
        if not b2 or b2[0] != 0x59:
            continue

        frame = bytearray([0x59, 0x59]) + ser.read(7)
        if len(frame) != 9:
            return None

        if (sum(frame[:8]) & 0xFF) != frame[8]:
            continue

        dist = frame[2] | (frame[3] << 8)
        strength = frame[4] | (frame[5] << 8)

        if dist < MIN_DIST or dist > MAX_DIST:
            return None

        if strength < MIN_STRENGTH:
            return None

        return dist, strength


def median(vals):
    vals = sorted(vals)
    return vals[len(vals) // 2]


def main():
    ser = serial.Serial(PORT, BAUD, timeout=0.15)
    speaker = Speaker()

    hist = deque(maxlen=HISTORY)

    warn_count = 0
    danger_count = 0
    no_object_count = 0

    level = "SAFE"

    print("TFmini walking assistant v2 started")
    speaker.say("System ready", gap=0)

    try:
        while True:
            r = read_tfmini(ser)

            if r is None:
                no_object_count += 1

                if no_object_count >= NO_OBJECT_RESET_FRAMES:
                    hist.clear()
                    warn_count = 0
                    danger_count = 0
                    level = "SAFE"

                print("level=SAFE no valid object")
                time.sleep(0.05)
                continue

            no_object_count = 0

            dist, strength = r
            now = time.time()
            hist.append((now, dist))

            stable_dist = median([d for _, d in hist])
            speed = 0.0
            ttc = None

            if len(hist) >= 6:
                t0, d0 = hist[0]
                t1, d1 = hist[-1]
                dt = t1 - t0

                if dt > 0:
                    speed = (d0 - d1) / dt

                    if speed >= MIN_CLOSING_SPEED:
                        ttc = stable_dist / speed

            danger_raw = False
            warn_raw = False

            if stable_dist <= DANGER_DISTANCE:
                danger_raw = True

            elif ttc is not None and ttc <= DANGER_TTC and stable_dist <= 200:
                danger_raw = True

            elif stable_dist <= WARN_DISTANCE:
                warn_raw = True

            elif ttc is not None and ttc <= WARN_TTC and stable_dist <= 230:
                warn_raw = True

            if danger_raw:
                danger_count += 1
                warn_count = 0
            elif warn_raw:
                warn_count += 1
                danger_count = 0
            else:
                warn_count = 0
                danger_count = 0
                level = "SAFE"

            if danger_count >= REQUIRE_FRAMES_DANGER:
                level = "DANGER"
            elif warn_count >= REQUIRE_FRAMES_WARN:
                level = "WARN"

            print(
                f"dist={dist:4d}cm stable={stable_dist:4d}cm "
                f"speed={speed:6.1f}cm/s "
                f"ttc={'None' if ttc is None else f'{ttc:.2f}s'} "
                f"strength={strength} "
                f"warn_count={warn_count} danger_count={danger_count} "
                f"level={level}"
            )

            if level == "DANGER":
                speaker.say("Danger. Stop.", gap=1.2)

            elif level == "WARN":
                speaker.say("Object ahead.", gap=2.2)

            time.sleep(0.05)

    except KeyboardInterrupt:
        print("\nStopped")

    finally:
        ser.close()


if __name__ == "__main__":
    main()
