import time
import serial
import subprocess
import threading
import queue
from collections import deque

PORT = "/dev/serial0"
BAUD = 115200

# -----------------------------
# Safety thresholds for walking
# -----------------------------
WARN_DISTANCE = 140      # cm
DANGER_DISTANCE = 70     # cm

WARN_TTC = 3.5           # seconds
DANGER_TTC = 1.5         # seconds

MIN_CLOSING_SPEED = 35   # cm/s

MIN_VALID_DIST = 10
MAX_VALID_DIST = 1200
MIN_STRENGTH = 50

DIST_MEDIAN_WINDOW = 5
SPEED_WINDOW = 10

WARN_CONFIRM = 3
DANGER_CONFIRM = 2
SAFE_CONFIRM = 5

PRINT_EVERY = 1


class Speaker:
    def __init__(self):
        self.q = queue.Queue(maxsize=5)
        self.last_t = 0.0
        threading.Thread(target=self._run, daemon=True).start()

    def say(self, text, gap):
        now = time.time()
        if now - self.last_t < gap:
            return
        self.last_t = now
        try:
            self.q.put_nowait(text)
        except queue.Full:
            pass

    def _run(self):
        while True:
            text = self.q.get()
            subprocess.Popen(
                ["espeak", "-s", "145", "-a", "180", text],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )


def median(values):
    values = sorted(values)
    return values[len(values) // 2]


def main():
    ser = serial.Serial(PORT, BAUD, timeout=0.2)

    print("TFmini-S walking collision warning")
    print("Parser: valid-frame buffer mode")
    print("Ctrl+C to stop\n")

    speaker = Speaker()
    speaker.say("System ready", gap=0)

    buf = bytearray()

    dist_hist = deque(maxlen=DIST_MEDIAN_WINDOW)
    speed_hist = deque(maxlen=SPEED_WINDOW)

    warn_count = 0
    danger_count = 0
    safe_count = 0

    level = "SAFE"
    frame_i = 0

    try:
        while True:
            buf += ser.read(64)

            while len(buf) >= 9:
                if buf[0] != 0x59 or buf[1] != 0x59:
                    buf.pop(0)
                    continue

                frame = buf[:9]
                buf = buf[9:]

                checksum = sum(frame[:8]) & 0xFF
                if checksum != frame[8]:
                    continue

                dist = frame[2] | (frame[3] << 8)
                strength = frame[4] | (frame[5] << 8)
                temp = (frame[6] | (frame[7] << 8)) / 8.0 - 256

                if strength < MIN_STRENGTH:
                    continue

                if dist < MIN_VALID_DIST or dist > MAX_VALID_DIST:
                    continue

                now = time.time()

                dist_hist.append(dist)
                speed_hist.append((now, dist))

                if len(dist_hist) < DIST_MEDIAN_WINDOW:
                    continue

                stable_dist = median(list(dist_hist))

                closing_speed = 0.0
                ttc = None

                if len(speed_hist) >= 4:
                    t0, d0 = speed_hist[0]
                    t1, d1 = speed_hist[-1]
                    dt = t1 - t0

                    if dt > 0:
                        closing_speed = (d0 - d1) / dt

                    if closing_speed >= MIN_CLOSING_SPEED:
                        ttc = stable_dist / closing_speed

                danger_raw = False
                warn_raw = False

                # 1) Absolute distance danger
                if stable_dist <= DANGER_DISTANCE:
                    danger_raw = True

                # 2) TTC danger only when really approaching
                elif ttc is not None and ttc <= DANGER_TTC and stable_dist <= 250:
                    danger_raw = True

                # 3) Absolute distance warning
                elif stable_dist <= WARN_DISTANCE:
                    warn_raw = True

                # 4) TTC warning only when really approaching
                elif ttc is not None and ttc <= WARN_TTC and stable_dist <= 300:
                    warn_raw = True

                if danger_raw:
                    danger_count += 1
                    warn_count = 0
                    safe_count = 0

                elif warn_raw:
                    warn_count += 1
                    danger_count = 0
                    safe_count = 0

                else:
                    safe_count += 1
                    warn_count = 0
                    danger_count = 0

                if danger_count >= DANGER_CONFIRM:
                    level = "DANGER"

                elif warn_count >= WARN_CONFIRM:
                    level = "WARN"

                elif safe_count >= SAFE_CONFIRM:
                    level = "SAFE"

                frame_i += 1

                if frame_i % PRINT_EVERY == 0:
                    print(
                        f"level={level:6s} "
                        f"dist={dist:4d}cm "
                        f"stable={stable_dist:4d}cm "
                        f"speed={closing_speed:6.1f}cm/s "
                        f"ttc={'None' if ttc is None else f'{ttc:.2f}s'} "
                        f"strength={strength:5d} "
                        f"temp={temp:5.1f}C "
                        f"warn={warn_count} danger={danger_count} safe={safe_count}"
                    )

                if level == "DANGER":
                    speaker.say("Danger. Stop.", gap=1.1)

                elif level == "WARN":
                    speaker.say("Object ahead.", gap=2.0)

            time.sleep(0.02)

    except KeyboardInterrupt:
        print("\nStopped")

    finally:
        ser.close()


if __name__ == "__main__":
    main()
